rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Rules for bill images (created when creating a job)
    match /bills/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    // Rules for delivery proof images (created when completing a job)
    match /proofs/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    // Default rule: reject everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
